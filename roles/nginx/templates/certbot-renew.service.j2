[Unit]
Description=Certbot Renewal for {{ org_slug }}
After={{ nginx_service_name }}
Requires={{ nginx_service_name }}

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm \
    --name {{ unit_prefix }}-certbot-renew \
    -v {{ certbot_config_dir }}:/etc/letsencrypt:Z \
    -v {{ certbot_work_dir }}:/var/lib/letsencrypt:Z \
    -v {{ nginx_acme_dir }}:/var/www/acme-challenge:ro,Z \
    -v {{ nginx_certs_dir }}:/certs-out:Z \
    {{ certbot_image }} renew \
    --webroot -w /var/www/acme-challenge \
    --non-interactive \
    --deploy-hook "cp /etc/letsencrypt/live/{{ org_slug }}-bundle/fullchain.pem /certs-out/tls.crt && cp /etc/letsencrypt/live/{{ org_slug }}-bundle/privkey.pem /certs-out/tls.key && nginx -s reload"

StandardOutput=journal
StandardError=journal
