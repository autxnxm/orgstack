# Database
AUTHENTIK_POSTGRESQL__HOST={{ postgres_unit_name }}
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD={{ org_stack_secrets.authentik.db_password }}

# Redis
AUTHENTIK_REDIS__HOST={{ redis_unit_name }}
AUTHENTIK_REDIS__PASSWORD={{ org_stack_secrets.redis.password }}

# Authentik Core
AUTHENTIK_SECRET_KEY={{ org_stack_secrets.authentik.secret_key }}
AUTHENTIK_ERROR_REPORTING__ENABLED=false

