[Unit]
Description={{ org_slug }} PostgreSQL Database Server
After=local-fs.target

[Container]
Image={{ postgres_image }}
ContainerName={{ postgres_unit_name }}
AutoUpdate=registry
EnvironmentFile={{ postgres_config_dir }}/postgres.env
Volume={{ postgres_data_dir }}:/var/lib/postgresql/data:Z
Network={{ network_unit_name }}.network

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
